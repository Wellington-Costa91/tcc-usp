&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;cópia da referência&lt;br&gt;com 2% dos registros&lt;br&gt;alterados (cenários BRZ)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=1.5;dashed=1;dashPattern=4 3;fontSize=12;fontColor=#1B3139;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="240" width="180" height="120" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Volume landing&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;arquivo do lote&lt;br&gt;entregue pela origem&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#EAF1F3;strokeColor=#1B3139;strokeWidth=1.5;fontSize=12;fontColor=#1B3139;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="286" y="240" width="180" height="120" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Bronze&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;dados como chegaram,&lt;br&gt;com os registros&lt;br&gt;problemáticos&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#EAF1F3;strokeColor=#1B3139;strokeWidth=1.5;fontSize=12;fontColor=#1B3139;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="492" y="240" width="180" height="120" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;T1&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;validação GX&lt;br&gt;Bronze → Silver&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF1EE;strokeColor=#FF3621;strokeWidth=1.5;fontSize=12;fontColor=#1B3139;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="698" y="240" width="180" height="120" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;datas tipadas; registros&lt;br&gt;marcados co