style=&amp;quot;font-size:11px&amp;quot;&gt;mesmas regras em PySpark,&lt;br&gt;sem GX e sem a lista de alterados&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F7F1;strokeColor=#00A972;strokeWidth=1.5;fontSize=12;fontColor=#1B3139;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="652" width="380" height="72" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;Comparação&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;por registro, regra e etapa:&lt;br&gt;VP, FN, FP e VN;&lt;br&gt;sensibilidade, precisão,&lt;br&gt;especificidade e F1&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F7F1;strokeColor=#00A972;strokeWidth=1.5;fontSize=12;fontColor=#1B3139;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="904" y="575" width="392" height="140" as="geometry"/></mxCell><mxCell id="e_b1e1" value="registros alterados" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#FF3621;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#FF3621;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.237;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_e1e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#00A972;strokeWidth=1.5;fontSize=10;fontColor=#00A972;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="e1" target="e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_e2e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#00A972;strokeWidth=1.5;fontSize=10;fontColor=#00A972;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_c1e3" value="capturas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#00A972;strokeWidth=1.5;fontSize=10;fontColor=#00A972;labelBackgroundColor=#FFFFFF;exitX=0.679;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1" value="&lt;b&gt;Legenda:&lt;/b&gt; &amp;nbsp;&lt;font color='#1B3139'&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; fluxo de dados &amp;nbsp;&amp;nbsp; &lt;font color='#FF3621'&gt;&lt;b&gt;╍╍▶&lt;/b&gt;&lt;/font&gt; registros alterados (guardados à parte) &amp;nbsp;&amp;nbsp; &lt;font color='#5A6F77'&gt;&lt;b&gt;┈┈▶&lt;/b&gt;&lt;/font&gt; captura &amp;nbsp;&amp;nbsp; &lt;font color='#00A972'&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt; avaliação &amp;nbsp;&amp;nbsp; cilindro: dado persistido &amp;nbsp;&amp;nbsp; borda laranja: validação GX (contínua) ou alteração de registros (tracejada)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B3139;" vertex="1" parent="1"><mxGeometry x="80" y="752" width="1480" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>