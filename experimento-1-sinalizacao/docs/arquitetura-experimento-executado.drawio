<mxfile host="drawio"><diagram id="exp" name="Experimento executado"><mxGraphModel dx="1600" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="800" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cA" value="Preparação&lt;br&gt;(antes da Bronze)" style="swimlane;horizontal=0;startSize=44;rounded=1;arcSize=2;html=1;whiteSpace=wrap;dashed=1;dashPattern=6 4;fillColor=#EEF2F4;swimlaneFillColor=#F7F9FA;strokeColor=#5A6F77;fontSize=13;fontStyle=1;fontColor=#1B3139;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1540" height="150" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Volume raw&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;arquivos originais do DataSUS&lt;br&gt;(.dbc) e malha municipal do IBGE&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#EAF1F3;strokeColor=#1B3139;strokeWidth=1.5;fontSize=12;fontColor=#1B3139;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="45" width="260" height="100" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Extração&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;leitura dos .dbc no ambiente:&lt;br&gt;966.987 registros, 122 campos&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3139;strokeWidth=1.5;fontSize=12;fontColor=#1B3139;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="380" y="45" width="260" height="100" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Limpeza&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:11px&amp;quot;&gt;exclui 16.072 registros que já&lt;br&gt;violam as regras ou não se aplicam&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3139;strokeWidth=1.5;fontSize=12;fontColor=#1B3